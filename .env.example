# All values are server-side. Copy to .env.local, which is ignored by Git.
# Site URL(s) customers open, comma-separated. Vercel deployment, branch and production URLs are allowed automatically.
APP_ORIGIN=http://localhost:3000
# Neon (or any Postgres) connection string. Keep it only in .env.local.
DATABASE_URL=
ENABLE_DEMO_RESET=false
# Private owner portal (/owner) where you create the usernames that may chat and use /admin.
# Run npm run owner:hash locally; paste the salt:hash output here.
OWNER_USERNAME=
OWNER_PASSWORD_HASH=

GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Accepts a prebuilt name or a designed voice_... ID for a regional accent.
GEMINI_TTS_STYLE=Warm, conversational shop assistant. Speak at a relaxed pace with clear pronunciation.
# Set true ONLY after confirming BOTH projects are free-tier, with no paid billing,
# the selected models are available and your account has nonzero free quotas.
PROVIDER_FREE_TIER_CONFIRMED=false
# Urdu is absent from the reviewed official TTS language table. Keep false until
# npm run providers:check produces an acceptable sample and you approve playback.
URDU_TTS_APPROVED=false
# Leave false unless a trusted reverse proxy overwrites x-forwarded-for.
TRUST_PROXY=false
